# Copy to .env.local (gitignored). Works with every value empty: simulated try-on, rules diagnosis.
# After editing, run: npm run doctor

# ── Try-on (Clothsy AI by FabricVTON) ── server-side only, never expose to the browser
# Get one: https://app.clothsyai.fabricvton.com/api-keys → Developer API → Create API key (starts clothsy_live_)
CLOTHSY_API_KEY=
CLOTHSY_API_BASE=https://api.clothsyai.fabricvton.com/api/v1
# auto: live when CLOTHSY_API_KEY is set, else simulated dev double
# live: always call the API · dev: always simulated (0 credits) · replay: cached renders only, misses → dev double
TRYON_MODE=auto
# Keep the daily cap at or below the credits you have left (20 free on a new account; npm run doctor
# shows the balance and fails while the cap is higher). Lower it to 13 after the 7-credit probe.
DAILY_LIVE_RENDER_CAP=18
MAX_RENDERS_PER_RETURN=5
# When set, only browsers that unlocked with this code (cookie tb_live) spend live credits.
# Set it on every public deployment.
LIVE_ACCESS_CODE=
# USD per credit for the unit-economics panel (0.08 is a placeholder)
CREDIT_USD=0.08

# ── Dev double ──
DEV_RENDER_LATENCY_MS=6000
DEV_FAIL_RATE=0

# ── Return-reason diagnosis (optional; falls back to deterministic rules) ──
# Text only, never the photo. Without a key the keyword rules handle the form text.
ANTHROPIC_API_KEY=
DIAGNOSIS_MODEL=claude-opus-5-5

# ── Storage ──
TRYBACK_DATA_DIR=.data

# ── Deployment / admin (docs/DEPLOY.md) ──
# Admin token for full resets, retention status/sweep and pins (openssl rand -hex 24).
# Unset = disabled; "Reset demo" then clears only the caller's own returns.
ADMIN_TOKEN=
# Leave unset: a production server (npm start / Docker) without LIVE_ACCESS_CODE treats
# everyone as replay unless this is 1, so a public URL can't drain credits.
ALLOW_PUBLIC_LIVE=
# Retention: default and maximum, as promised in the consent copy (values can only shorten it)
PHOTO_RETENTION_HOURS=24
RENDER_RETENTION_DAYS=14
# Leave unset: 1 serves the dev-only /dev/gate-lab calibration page on a production server
ENABLE_GATE_LAB=
# Which header names the caller for rate limits. Unset = fly-client-ip on Fly, true-client-ip on
# Render, else the last X-Forwarded-For hop (set by Caddy/nginx). Or: x-real-ip, cf-connecting-ip, none.
CLIENT_IP_HEADER=

# Behind a company proxy, start Node with NODE_EXTRA_CA_CERTS=/path/to/company-root.pem
# (a shell variable, not read from this file) so the server, doctor and probe reach the APIs.
